NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Csak az egyszeri Excel-importhoz; soha ne add át a böngészőnek!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Opcionális: az importálandó fájl pontos útvonala
EXCEL_FILE=data/meresek.xlsx

# Growatt / ShinePhone – kizárólag szerveroldali változók. Értékeket ne commitolj.
GROWATT_API_TOKEN=
GROWATT_ALLOWED_USER_ID=
GROWATT_CREDENTIAL_VERSION=1
# Európai tokenes OpenAPI V1; a read-only endpointok a szerverkódban allowlisteltek.
GROWATT_API_BASE_URL=https://openapi.growatt.com/v1/
