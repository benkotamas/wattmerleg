NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Csak az egyszeri Excel-importhoz; soha ne add át a böngészőnek!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Opcionális: az importálandó fájl pontos útvonala
EXCEL_FILE=data/meresek.xlsx

# Growatt / ShinePhone – kizárólag szerveroldali változók. Értékeket ne commitolj.
GROWATT_API_TOKEN=
GROWATT_ALLOWED_USER_ID=
GROWATT_CREDENTIAL_VERSION=1
# Az alábbiakat csak a fiókhoz kapott hivatalos OpenAPI dokumentáció alapján töltsd ki.
GROWATT_API_BASE_URL=
GROWATT_API_AUTH_HEADER=
GROWATT_API_AUTH_VALUE_TEMPLATE={token}
GROWATT_PLANTS_PATH=
GROWATT_PLANTS_METHOD=GET
GROWATT_DEVICES_PATH=
GROWATT_DEVICES_METHOD=GET
GROWATT_LATEST_PATH=
GROWATT_LATEST_METHOD=GET
GROWATT_FIELD_MAP_JSON=
